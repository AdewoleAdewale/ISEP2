<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView" xmlns:renderers="clr-namespace:ISEP.Randerers"
             x:Class="ISEP.Views.ChangePin" NavigationPage.HasNavigationBar="True" 
    BackgroundColor="#032d6e"
      Padding="0,10,0,0">


    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout >

            <Grid Margin="0,0,0,0">

                <StackLayout Margin="20,10,20,0" Spacing="10">

                    <Label
                    FontAttributes="Bold"
                    FontSize="20"
                        Padding="10"
                    Text="CHANGE PIN"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" />
                </StackLayout>



            </Grid>
            <yummy:PancakeView
            Margin="0,20,0,0"
            Padding="30,50,30,30"
            BackgroundColor="White"
            CornerRadius="20,20,0,0"
            VerticalOptions="FillAndExpand">
                <StackLayout Spacing="10">


                    <StackLayout Spacing="10">
                        <Label
                        Margin="20,0,0,0"
                        FontSize="15"
                            FontAttributes="Bold"
                        Text="CURRENT PIN"
                        TextColor="#032d6e" />
                        <yummy:PancakeView
                        Padding="10,0,0,0"
                        BackgroundColor="WhiteSmoke"
                        BorderThickness="1"
                        CornerRadius="5"
                               BorderGradientEndColor="#032d6e"
                            BorderGradientStartColor="#2575fc"
                        Elevation="3"                            
                        HeightRequest="50">
                            <renderers:BorderlessEntry
                            FontSize="12"
                            ClearButtonVisibility="WhileEditing"
                            IsPassword="True"    
                                 BackgroundColor="WhiteSmoke"
                            TextColor="#484848"
                                x:Name="OldPINEntry"/>
                        </yummy:PancakeView>
                    </StackLayout>

                    <StackLayout Spacing="10">
                        <Label
                        Margin="20,0,0,0"
                        FontSize="15"
                            FontAttributes="Bold"
                        Text="CONFIRM NEW PIN"
                        TextColor="#032d6e" />
                        <yummy:PancakeView
                        Padding="10,0,0,0"
                        BackgroundColor="WhiteSmoke"
                        BorderThickness="1"
                               BorderGradientEndColor="#032d6e"
                            BorderGradientStartColor="#2575fc"
                        CornerRadius="5"
                        Elevation="3"
                        HeightRequest="50">
                            <renderers:BorderlessEntry
                            FontSize="12"
                                 BackgroundColor="WhiteSmoke"
                             ClearButtonVisibility="WhileEditing"
                            IsPassword="True"
                            TextColor="#484848" 
                                x:Name="ConfirmPIN"/>
                        </yummy:PancakeView>
                    </StackLayout>



                    <yummy:PancakeView
              BackgroundColor="Transparent" BackgroundGradientStartColor="#032d6e"
                    BackgroundGradientAngle="45" BackgroundGradientEndColor="#032d6e"  BorderColor="Transparent"
                     Elevation="5"
                BorderThickness="1"
       
                HasShadow="True"
                 Margin="0, 30, 0, 0"
                HeightRequest="55"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand"
                WidthRequest="150">
                        <Label
                    FontAttributes="Bold"
                    FontSize="17"
                    HorizontalOptions="CenterAndExpand"
                    Text="UPDATE PIN"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" >

                        </Label>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" ></TapGestureRecognizer>
                        </yummy:PancakeView.GestureRecognizers>



                    </yummy:PancakeView>

                </StackLayout>
            </yummy:PancakeView>
        </StackLayout>
    </ScrollView>
</ContentPage>