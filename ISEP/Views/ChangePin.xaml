<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.ChangePin"
             Title="Change PIN"
             BackgroundColor="#0A192F">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout Padding="20" Spacing="20">

            <Label Text="CHANGE TRANSACTION PIN" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>

            <yummy:PancakeView BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="True" Elevation="6">
                <StackLayout Spacing="16">

                    <!-- Current PIN -->
                    <StackLayout Spacing="6">
                        <Label Text="CURRENT PIN" TextColor="#0F172A" FontSize="11" FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#CBD5E1" CornerRadius="10" Padding="12,0" HeightRequest="48" HasShadow="False">
                            <Entry x:Name="OldPINEntry" IsPassword="True" Keyboard="Numeric" MaxLength="4" Placeholder="4-digit current PIN" TextColor="#0F172A" FontSize="14"/>
                        </Frame>
                    </StackLayout>

                    <!-- New PIN -->
                    <StackLayout Spacing="6">
                        <Label Text="CONFIRM NEW PIN" TextColor="#0F172A" FontSize="11" FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#CBD5E1" CornerRadius="10" Padding="12,0" HeightRequest="48" HasShadow="False">
                            <Entry x:Name="ConfirmPIN" IsPassword="True" Keyboard="Numeric" MaxLength="4" Placeholder="4-digit new PIN" TextColor="#0F172A" FontSize="14"/>
                        </Frame>
                    </StackLayout>

                    <!-- Submit Button -->
                    <Button Text="UPDATE PIN" BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Margin="0,10,0,0" Clicked="UpdatePin_Clicked"/>

                </StackLayout>
            </yummy:PancakeView>

        </StackLayout>
    </ScrollView>
</ContentPage>