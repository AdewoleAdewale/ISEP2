<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.Dashboard"
             BackgroundColor="#F8FAFC"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="BrandNavy">#0A192F</Color>
            <Color x:Key="BrandNavyLight">#1E3A8A</Color>
            <Color x:Key="BrandGreen">#059669</Color>
            <Color x:Key="BrandGold">#D97706</Color>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#0F172A"/>
                <Setter Property="CharacterSpacing" Value="2.0"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView BackgroundColor="#F8FAFC">
            <StackLayout Spacing="0">

                <!-- HERO HEADER -->
                <yummy:PancakeView CornerRadius="0,0,12,12" HasShadow="True" Elevation="12" Padding="0">
                    <yummy:PancakeView.BackgroundGradientStops>
                        <yummy:GradientStopCollection>
                            <yummy:GradientStop Color="#030712" Offset="0.0"/>
                            <yummy:GradientStop Color="#0A192F" Offset="0.5"/>
                            <yummy:GradientStop Color="#1E3A8A" Offset="1.0"/>
                        </yummy:GradientStopCollection>
                    </yummy:PancakeView.BackgroundGradientStops>

                    <StackLayout Spacing="0" Padding="20,15,20,25">

                        <!-- Top Navigation Bar -->
                        <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8" Margin="0,0,0,20">
                            <yummy:PancakeView Grid.Column="0" BackgroundColor="White"
                                               CornerRadius="12" WidthRequest="48" HeightRequest="48">
                                <Image Source="hamburger" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </yummy:PancakeView>

                            <StackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                <Label Text="BORNO REVENUE" FontSize="16" FontAttributes="Bold" CharacterSpacing="2" TextColor="#F59E0B" HorizontalOptions="Center"/>
                                <Label Text="ISEP COLLECTION TERMINAL" FontSize="8" CharacterSpacing="1.5" TextColor="#94A3B8" HorizontalOptions="Center"/>
                            </StackLayout>

                            <yummy:PancakeView Grid.Column="2" BackgroundColor="#1EFFFFFF"
                                               CornerRadius="12" WidthRequest="48" HeightRequest="48">
                                <Image Source="logout" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLogoutTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </yummy:PancakeView>
                        </Grid>

                        <!-- Agent Profile Card -->
                        <Grid ColumnDefinitions="*,70">
                            <StackLayout Grid.Column="0" Spacing="6">
                                <yummy:PancakeView BackgroundColor="#22F59E0B" CornerRadius="6" Padding="8,4" HorizontalOptions="Start">
                                    <Label Text="REVENUE OFFICER" FontSize="8" FontAttributes="Bold" CharacterSpacing="1.5" TextColor="#F59E0B"/>
                                </yummy:PancakeView>

                                <Label x:Name="AgentNameLabel" TextColor="White" FontSize="20" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                <Label x:Name="MdaLabel" TextColor="#10B981" FontSize="11" LineBreakMode="TailTruncation"/>
                                <Label x:Name="WelcomeLabel" TextColor="#94A3B8" FontSize="11"/>
                            </StackLayout>

                            <yummy:PancakeView Grid.Column="1" BackgroundColor="#15FFFFFF" CornerRadius="16" WidthRequest="64" HeightRequest="64" HorizontalOptions="End" VerticalOptions="Center">
                                <Image Source="Borno" Aspect="AspectFit" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </yummy:PancakeView>
                        </Grid>

                        <!-- Analytics Stats Strip -->
                        <yummy:PancakeView BackgroundColor="#18FFFFFF" CornerRadius="16" Padding="12,14" Margin="0,20,0,0">
                            <Grid ColumnDefinitions="*,1,*,1,*">

                                <StackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                    <Label x:Name="StatInvoices" Text="—" FontSize="20" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                                    <Label Text="INVOICES" FontSize="8" CharacterSpacing="1" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                </StackLayout>

                                <BoxView Grid.Column="1" BackgroundColor="#22FFFFFF" WidthRequest="1" VerticalOptions="Fill"/>

                                <StackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                    <Label x:Name="StatTotalAmount" Text="—" FontSize="15" FontAttributes="Bold" TextColor="#10B981" HorizontalOptions="Center" LineBreakMode="TailTruncation"/>
                                    <Label Text="COLLECTED" FontSize="8" CharacterSpacing="1" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                </StackLayout>

                                <BoxView Grid.Column="3" BackgroundColor="#22FFFFFF" WidthRequest="1" VerticalOptions="Fill"/>

                                <StackLayout Grid.Column="4" Spacing="2" HorizontalOptions="Center">
                                    <Label x:Name="StatPending" Text="—" FontSize="20" FontAttributes="Bold" TextColor="#F59E0B" HorizontalOptions="Center"/>
                                    <Label Text="PENDING" FontSize="8" CharacterSpacing="1" TextColor="#94A3B8" HorizontalOptions="Center"/>
                                </StackLayout>

                            </Grid>
                        </yummy:PancakeView>

                    </StackLayout>
                </yummy:PancakeView>

                <!-- ══════════════════════════════════════════════════
                     WALLET / ACCOUNT DETAILS
                     Populated from the SagentLogin `detail` object.
                     Overlaps the hero by -28 so it reads as one unit.
                     ══════════════════════════════════════════════════ -->
                <yummy:PancakeView Margin="16,-28,16,0" Padding="0"
                                   BackgroundColor="White" CornerRadius="20"
                                   HasShadow="True" Elevation="10">
                    <StackLayout Spacing="0" Padding="16,14">

                        <!-- Balance row + trading status badge -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <Label Grid.Column="0" Text="WALLET BALANCE"
                                   FontSize="9" FontAttributes="Bold" CharacterSpacing="1.5"
                                   TextColor="#64748B" VerticalOptions="Center"/>

                            <yummy:PancakeView Grid.Column="1" x:Name="StatusBadge"
                                               BackgroundColor="#DCFCE7" CornerRadius="6"
                                               Padding="8,3" HorizontalOptions="End">
                                <Label x:Name="TradingStatusLabel" Text="—"
                                       FontSize="9" FontAttributes="Bold"
                                       CharacterSpacing="1" TextColor="#059669"/>
                            </yummy:PancakeView>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" x:Name="BalanceLabel" Text="₦—"
                                   FontSize="28" FontAttributes="Bold" TextColor="#0A192F"
                                   LineBreakMode="TailTruncation" VerticalOptions="Center"/>

                            <!-- Balance is sensitive on a shared terminal — allow hiding -->
                            <Label Grid.Column="1" x:Name="BalanceToggle" Text="+"
                                   FontSize="18" VerticalOptions="Center" Margin="8,0,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleBalanceTapped"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" Margin="0,14"/>

                        <!-- Account name -->
                        <Label Text="ACCOUNT NAME" FontSize="8" FontAttributes="Bold"
                               CharacterSpacing="1.2" TextColor="#94A3B8"/>
                        <Label x:Name="AccountNameLabel" Text="—" FontSize="13"
                               FontAttributes="Bold" TextColor="#0F172A"
                               LineBreakMode="TailTruncation" Margin="0,2,0,10"/>

                        <!-- Bank + account number -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="BANK" FontSize="8" FontAttributes="Bold"
                                       CharacterSpacing="1.2" TextColor="#94A3B8"/>
                                <Label x:Name="BankLabel" Text="—" FontSize="13"
                                       TextColor="#0F172A" LineBreakMode="TailTruncation"/>
                            </StackLayout>

                            <StackLayout Grid.Column="1" Spacing="2">
                                <Label Text="ACCOUNT NUMBER" FontSize="8" FontAttributes="Bold"
                                       CharacterSpacing="1.2" TextColor="#94A3B8"/>

                                <!-- Whole row is tappable, not just the icon —
                                     a 12px glyph is well under the 44px touch target -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" x:Name="AccountNumberLabel" Text="—"
                                           FontSize="15" FontAttributes="Bold" TextColor="#059669"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="🙈" FontSize="14"
                                           VerticalOptions="Center" Margin="6,0,0,0"/>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCopyAccountNumberTapped"/>
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </StackLayout>
                        </Grid>

                        <!-- Actions -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,16,0,0">
                            <Button Grid.Column="0" Text="COPY DETAILS"
                                    BackgroundColor="#0A192F" TextColor="White"
                                    FontAttributes="Bold" FontSize="11" CornerRadius="10"
                                    HeightRequest="42" Clicked="OnCopyDetailsTapped"/>
                            <Button Grid.Column="1" Text="CASH OUT"
                                    BackgroundColor="#1E3A8A" TextColor="White"
                                    FontAttributes="Bold" FontSize="11" CornerRadius="10"
                                    HeightRequest="42" Clicked="OnCashoutTapped"/>
                        </Grid>

                    </StackLayout>
                </yummy:PancakeView>

                <!-- QUICK SERVICES -->
                <StackLayout Margin="16,22,16,0" Spacing="12">
                    <Label Text="QUICK ACTIONS" Style="{StaticResource SectionLabel}"/>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <!-- PROCESS PAYMENT -->
                        <yummy:PancakeView Grid.Column="0" BackgroundColor="White" CornerRadius="16" HasShadow="True" Elevation="4" Padding="10,16">
                            <StackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="payment" HeightRequest="50"  HorizontalOptions="Center"/>
                                <Label Text="PAYMENT" FontSize="9" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDirectPaymentTapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                        <!-- VERIFY RRR -->
                        <yummy:PancakeView Grid.Column="1" BackgroundColor="White" CornerRadius="16" HasShadow="True" Elevation="4" Padding="10,16">
                            <StackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="verify" HeightRequest="50"  HorizontalOptions="Center"/>
                                <Label Text="VERIFY RRR" FontSize="9" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnVerifyPaymentTapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                        <!-- REPORTS -->
                        <yummy:PancakeView Grid.Column="2" BackgroundColor="White" CornerRadius="16" HasShadow="True" Elevation="4" Padding="10,16">
                            <StackLayout Spacing="8" VerticalOptions="Center">
                                <Image Source="make" HeightRequest="50"  HorizontalOptions="Center"/>
                                <Label Text="HISTORY" FontSize="9" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTaxReportTapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>
                    </Grid>
                </StackLayout>

                <!-- RECENT TRANSACTIONS FEED -->
                <StackLayout Margin="16,24,16,0" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="RECENT ACTIVITY" Style="{StaticResource SectionLabel}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="SEE ALL ›" FontSize="11" FontAttributes="Bold" TextColor="#059669">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnInvoiceHistoryTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Loading -->
                    <yummy:PancakeView x:Name="TxnLoadingCard" BackgroundColor="White" CornerRadius="12" Padding="16" IsVisible="True">
                        <StackLayout Orientation="Horizontal" Spacing="12" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="True" Color="#0A192F" WidthRequest="20" HeightRequest="20"/>
                            <Label Text="Fetching recent collection data..." FontSize="12" TextColor="#64748B"/>
                        </StackLayout>
                    </yummy:PancakeView>

                    <!-- Empty -->
                    <yummy:PancakeView x:Name="TxnEmptyCard" BackgroundColor="White" CornerRadius="12" Padding="20" IsVisible="False">
                        <StackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="📭" FontSize="32" HorizontalOptions="Center"/>
                            <Label Text="No recent transactions found" FontSize="12" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center"/>
                        </StackLayout>
                    </yummy:PancakeView>

                    <!-- Error -->
                    <yummy:PancakeView x:Name="TxnErrorCard" BackgroundColor="White" CornerRadius="12" Padding="14" IsVisible="False">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" x:Name="TxnErrorLabel" Text="Could not load history." FontSize="12" TextColor="#DC2626"/>
                            <Button Grid.Column="1" Text="Retry" FontSize="11" HeightRequest="32" Clicked="OnTxnRetryTapped"/>
                        </Grid>
                    </yummy:PancakeView>

                    <!-- List Feed -->
                    <ListView x:Name="TransactionListView"
                              BackgroundColor="Transparent"
                              HasUnevenRows="True"
                              SeparatorVisibility="None"
                              SelectionMode="None"
                              IsVisible="False"
                              HeightRequest="400"
                              CachingStrategy="RetainElement">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <yummy:PancakeView BackgroundColor="White" Margin="0,0,0,10" CornerRadius="12" HasShadow="True" Elevation="3" Padding="12">
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding payer_Name}" FontAttributes="Bold" FontSize="13" TextColor="#0F172A" LineBreakMode="TailTruncation"/>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding amount, StringFormat='₦{0:N0}'}" FontAttributes="Bold" FontSize="13" TextColor="#1E3A8A"/>

                                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding service_Name}" FontSize="11" TextColor="#64748B"/>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding status}" FontSize="10" FontAttributes="Bold" TextColor="#D97706"/>
                                        </Grid>
                                    </yummy:PancakeView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </StackLayout>

                <!-- ACCOUNT SECURITY — these pages existed but had no
                     entry point anywhere in the app until now -->
                <StackLayout Margin="16,24,16,0" Spacing="12">
                    <Label Text="ACCOUNT SECURITY" Style="{StaticResource SectionLabel}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <yummy:PancakeView Grid.Column="0" BackgroundColor="White" CornerRadius="10"
                                           HasShadow="True" Elevation="4" Padding="12,14">
                            <StackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="🔑" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="CHANGE PIN" FontSize="9" FontAttributes="Bold"
                                       TextColor="#0F172A" HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePinTapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>

                        <yummy:PancakeView Grid.Column="1" BackgroundColor="White" CornerRadius="10"
                                           HasShadow="True" Elevation="4" Padding="12,14">
                            <StackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="🔒" FontSize="20" HorizontalOptions="Center"/>
                                <Label Text="CHANGE PASSWORD" FontSize="9" FontAttributes="Bold"
                                       TextColor="#0F172A" HorizontalTextAlignment="Center"/>
                            </StackLayout>
                            <yummy:PancakeView.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnChangePasswordTapped"/>
                            </yummy:PancakeView.GestureRecognizers>
                        </yummy:PancakeView>
                    </Grid>
                </StackLayout>

                <!-- PRINTER & DIAGNOSTICS STRIP -->
                
                <yummy:PancakeView Margin="16,20,16,30" Padding="16,12" BackgroundColor="White" CornerRadius="16" HasShadow="True" Elevation="3">
                    <Grid ColumnDefinitions="*, Auto">
                        <StackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="HARDWARE DIAGNOSTICS" FontSize="10" FontAttributes="Bold" TextColor="#0F172A"/>
                            <Label Text="Test Bluetooth ESC/POS printer status" FontSize="10" TextColor="#64748B"/>
                        </StackLayout>
                        <Button Grid.Column="1" Text="TEST PRINTER" BackgroundColor="#1E3A8A" TextColor="White" FontAttributes="Bold" FontSize="11" CornerRadius="8" HeightRequest="36" Clicked="TestPrinter_Clicked"/>
                    </Grid>
                </yummy:PancakeView>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>