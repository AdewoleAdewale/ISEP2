                    FontAttributes="Bold"
                    FontSize="20"
                                            Margin="5"
                    HorizontalOptions="FillAndExpand"
                    x:Name="CashoutBalance" 
                                          
                    TextColor="Red"
                    VerticalOptions="CenterAndExpand" >

                                        </Label>
                         

                                    </yummy:PancakeView>

                                    <Image Source="Borno" Aspect="AspectFit" HeightRequest="100" HorizontalOptions="EndAndExpand" Margin="0,-10,0,10"></Image>

                                </StackLayout>
                                <StackLayout Orientation="Horizontal"  HorizontalOptions="FillAndExpand" Margin="0,-15,0,0">
                                    <Label Text="_______________________________________________________________" TextColor="White" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"></Label>

                                </StackLayout>
                                <StackLayout Orientation="Horizontal" Spacing="2">
                                    <Image Source="people" Aspect="AspectFit" HeightRequest="20"></Image>
                                    <Label  x:Name="Agentname" FontAttributes="Bold"  FontSize="15" LineBreakMode="HeadTruncation" TextColor="White" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand" ></Label>

                                </StackLayout>
