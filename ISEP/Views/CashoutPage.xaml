                    <StackLayout Spacing="10" Margin="10,10,10,10">

                        <yummy:PancakeView Elevation="5" BorderThickness="5" BackgroundGradientAngle="0" BackgroundGradientStartColor="#005bea" BackgroundGradientEndColor="#00c6fb" 
                  HorizontalOptions="FillAndExpand" Padding="10" VerticalOptions="FillAndExpand" WidthRequest="100" HeightRequest="200" CornerRadius="10">
                            <StackLayout >
                                <StackLayout Orientation="Horizontal" Spacing="2" Margin="0,5,0,0">
                                    <Image Source="status" Aspect="AspectFit" HeightRequest="20"></Image>
                                    <Label x:Name="AgentSupervisor" TextColor="White" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" HorizontalOptions="Start">
                                    </Label>
                                    
                                </StackLayout>
                                <Label Text="_______________________________________________________________" TextColor="White" Margin="0,-10,0,0" HorizontalOptions="StartAndExpand" VerticalOptions="StartAndExpand"></Label>

                                <StackLayout Orientation="Horizontal" Spacing="1">

                               
                                    <yummy:PancakeView
              BackgroundColor="Transparent" BackgroundGradientStartColor="LightSkyBlue"
                    BackgroundGradientAngle="90" BackgroundGradientEndColor="LightSkyBlue"  BorderColor="Transparent"
                     Elevation="5"
                                        Opacity="0.8"
                BorderThickness="1"
                 Margin="0, 10,10,10"
                HeightRequest="50"
                CornerRadius="5"
                HorizontalOptions="StartAndExpand"
          VerticalOptions="StartAndExpand"
                WidthRequest="200">
