                        </yummy:PancakeView>

                    </StackLayout>




                 

                    <StackLayout Spacing="5" Margin="0,0,0,10" Padding="10,10,10,10">

                        <Label
                     
                    FontAttributes="Bold"
                    FontSize="12"
                    Text="Kindly Input Your Transaction Pin To Process Cashout And Lastly The Minimum Amount You Can Process For Cashout Is 500naira. "
                    TextColor="Red"
                    HorizontalTextAlignment="Center" >

                        </Label>
                     



                        <Frame
                        Margin="0,10,0,15"
                        Padding="0"
                        BackgroundColor="WhiteSmoke"
                        CornerRadius="5"
                                HeightRequest="40"
                        HasShadow="True">
                                <StackLayout HorizontalOptions="FillAndExpand" Orientation="Horizontal">
                                    <renderers:BorderlessEntry
                                FontSize="12"
                                Placeholder="Input Your Pin Here"
                                 x:Name="Password"  
                                 Keyboard="Numeric"
                                        MaxLength="4"
                                  PlaceholderColor="LightGray"
                              TextColor="#484848"
                                Margin="10,0,10,0"
                                FontFamily="Regular"
                                HorizontalOptions="FillAndExpand"
                                  IsPassword="{Binding Source={x:Reference ShowPasswordActualTrigger}, Path=HidePassword}"
                           />
                                    <Frame
                                Margin="10,0"
                                Padding="0"
                                BackgroundColor="Transparent"
                                HeightRequest="20"
                                WidthRequest="20">
                                        <ImageButton VerticalOptions="Center"
                                   HeightRequest="20"
                                     HorizontalOptions="End"
                                   Source="icons8eyes">
                                            <ImageButton.Triggers>
                                                <EventTrigger Event="Clicked">
                                                    <local:ShowPasswordTriggerAction ShowIcon="Openeyes"
                                                              HideIcon="icons8eyes"
                                                              x:Name="ShowPasswordActualTrigger"/>
                                                </EventTrigger>
                                            </ImageButton.Triggers>
                                        </ImageButton>

                                    </Frame>

                                </StackLayout>

                            </Frame>

                            <yummy:PancakeView
              BackgroundColor="Transparent" BackgroundGradientStartColor="#032d6e"
                    BackgroundGradientAngle="45" BackgroundGradientEndColor="#2575fc"  BorderColor="Transparent"
                     Elevation="5"
                BorderThickness="1"
       
                HasShadow="True"
                 Margin="0, 30, 0, 0"
                HeightRequest="55"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand"
                WidthRequest="150">
                                <Label
                    FontAttributes="Bold"
                    FontSize="17"
                    HorizontalOptions="CenterAndExpand"
                    Text="PROCESS CASHOUT "
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" >

                                </Label>
                                <yummy:PancakeView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="Button_Clicked" ></TapGestureRecognizer>
                                </yummy:PancakeView.GestureRecognizers>



                            </yummy:PancakeView>

                        </StackLayout>



                    </StackLayout>

                </yummy:PancakeView>
