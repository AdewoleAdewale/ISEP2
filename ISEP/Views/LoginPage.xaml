<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.LoginPage"
             BackgroundColor="#0A192F"
             NavigationPage.HasNavigationBar="False">

    <ScrollView VerticalOptions="FillAndExpand">
        <StackLayout Padding="30,60,30,30" Spacing="25">
            <!-- Header -->
            <StackLayout Spacing="5" HorizontalOptions="Center">
                <Image Source="Borno" HeightRequest="90" Aspect="AspectFit"/>
                <Label Text="BORNO REVENUE PORTAL" TextColor="White" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                <Label Text="Sign in to continue" TextColor="#94A3B8" FontSize="14" HorizontalTextAlignment="Center"/>
            </StackLayout>

            <!-- Form Container -->
            <yummy:PancakeView BackgroundColor="White" CornerRadius="20" Padding="25" HasShadow="True" Elevation="8">
                <StackLayout Spacing="18">
                    <!-- Email Input -->
                    <StackLayout Spacing="6">
                        <Label Text="EMAIL ADDRESS" TextColor="#0F172A" FontSize="11" FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="10" Padding="12,0" HeightRequest="48" HasShadow="False">
                            <Entry x:Name="EmailEntry" Placeholder="agent@domain.com" Keyboard="Email" TextColor="#0F172A" FontSize="14"/>
                        </Frame>
                    </StackLayout>

                    <!-- Password Input -->
                    <StackLayout Spacing="6">
                        <Label Text="PASSWORD" TextColor="#0F172A" FontSize="11" FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#E2E8F0" CornerRadius="10" Padding="12,0" HeightRequest="48" HasShadow="False">
                            <Grid ColumnDefinitions="*, Auto">
                                <Entry x:Name="PasswordEntry" IsPassword="True" Placeholder="••••••••" TextColor="#0F172A" FontSize="14" Grid.Column="0"/>
                                
                            </Grid>
                        </Frame>
                    </StackLayout>

                    <!-- Checkboxes -->
                    <StackLayout Spacing="10" Margin="0,5">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <CheckBox x:Name="RememberMeCheck" Color="#059669" IsChecked="{Binding IsRememberMe}"/>
                            <Label Text="Remember Me (Auto Login)" TextColor="#475569" FontSize="13" VerticalOptions="Center"/>
                        </StackLayout>
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <CheckBox x:Name="RememberPasswordCheck" Color="#059669" IsChecked="{Binding IsRememberPassword}"/>
                            <Label Text="Remember My Password" TextColor="#475569" FontSize="13" VerticalOptions="Center"/>
                        </StackLayout>
                    </StackLayout>

                    <!-- Submit Button -->
                    <Button Text="SIGN IN" BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Clicked="Button_Clicked"/>
                </StackLayout>
            </yummy:PancakeView>

            <!-- Footer -->
            <Label Text="POWERED BY OSOFTPAY" TextColor="#64748B" FontSize="11" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
        </StackLayout>
    </ScrollView>
</ContentPage>