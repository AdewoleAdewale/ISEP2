<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.ChangePassword"
             Title="Change Password"
             BackgroundColor="#0A192F">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <StackLayout Padding="20" Spacing="20">

            <Label Text="CHANGE PASSWORD" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>

            <yummy:PancakeView BackgroundColor="White" CornerRadius="16" Padding="20" HasShadow="True" Elevation="6">
                <StackLayout Spacing="16">

                    <Label Text="NOTE: Your new password should contain at least 1 uppercase letter, 1 symbol, and be at least 8 characters long." 
                           TextColor="#DC2626" FontSize="11" HorizontalTextAlignment="Center"/>

                    <!-- Current Password -->
                    <StackLayout Spacing="6">
                        <Label Text="CURRENT PASSWORD" TextColor="#0F172A" FontSize="11" FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#CBD5E1" CornerRadius="10" Padding="12,0" HeightRequest="48" HasShadow="False">
                            <Entry x:Name="OldPasswordEntry" IsPassword="True" Placeholder="Enter current password" TextColor="#0F172A" FontSize="14"/>
                        </Frame>
                    </StackLayout>

                    <!-- New Password -->
                    <StackLayout Spacing="6">
                        <Label Text="NEW PASSWORD" TextColor="#0F172A" FontSize="11" FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8FAFC" BorderColor="#CBD5E1" CornerRadius="10" Padding="12,0" HeightRequest="48" HasShadow="False">
                            <Entry x:Name="ConfirmPassword" IsPassword="True" Placeholder="Enter new password" TextColor="#0F172A" FontSize="14"/>
                        </Frame>
                    </StackLayout>

                    <!-- Submit Button -->
                    <Button Text="UPDATE PASSWORD" BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" CornerRadius="10" HeightRequest="48" Margin="0,10,0,0" Clicked="UpdatePassword_Clicked"/>

                </StackLayout>
            </yummy:PancakeView>

        </StackLayout>
    </ScrollView>
</ContentPage>