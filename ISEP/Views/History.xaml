<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.History"   Padding="0,10,0,0"
    BackgroundColor="#032D6E"
    NavigationPage.HasNavigationBar="True">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">


        <StackLayout>

            <Label  Text=" AGENT TRANSACTION HISTORY" TextColor="White" FontSize="15" HorizontalOptions="FillAndExpand"  FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,10,0,0"/>


            <yummy:PancakeView
                Margin="0,30,0,0"
                Padding="30,20,30,30"
                BackgroundColor="White"
                CornerRadius="10,10,0,0"
                VerticalOptions="FillAndExpand">
                <StackLayout Spacing="5">

                    <Label Text="START DATE:"
                           TextColor="#032d6e"
                           Margin="20,0,0,0" FontAttributes="Bold"
                        FontSize="12"/>
                    <DatePicker x:Name="startDatePicker"
                    Format="D" FontSize="12"
                                 BackgroundColor="WhiteSmoke"
                    Margin="15, 0, 0, 30"  
                                
                     />

                    <Label Text="END DATE:" 
                           Margin="20,0,0,0" FontAttributes="Bold"
                           TextColor="#032d6e"
                        FontSize="12"/>
                    <DatePicker x:Name="endDatePicker"    FontSize="12"                        
                    MinimumDate="01/01/2017"
                    Format="D"
                                 BackgroundColor="WhiteSmoke"
                    Margin="15, 0, 0, 30"
                     />

                    <yummy:PancakeView
              BackgroundColor="Transparent" BackgroundGradientStartColor="#032d6e"
                    BackgroundGradientAngle="45" BackgroundGradientEndColor="#032d6e"  BorderColor="Transparent"
                     Elevation="5"
                BorderThickness="1"
       
                HasShadow="True"
                 Margin="0, 0, 0, 0"
                HeightRequest="50"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand"
                WidthRequest="150">
                        <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalOptions="CenterAndExpand"
                    Text="SEARCH FOR REPORT"
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" >

                        </Label>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" ></TapGestureRecognizer>
                        </yummy:PancakeView.GestureRecognizers>



                    </yummy:PancakeView>



                    <ListView x:Name="listView" SeparatorColor="Purple"  HasUnevenRows="True" ItemsSource="{Binding HD}"  HeightRequest="{Binding Size}" Margin="1,30,-10,10">
                        <ListView.Header>
                            <Label Text="AVAILABLE REPORT WITH DATE RANGE" TextColor="#032d6e" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <yummy:PancakeView HasShadow="True" BackgroundColor="White" VerticalOptions="StartAndExpand" 
                                    HorizontalOptions="FillAndExpand">
                                        <Grid VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <BoxView BackgroundColor="#032d6e" WidthRequest="3" HorizontalOptions="Start" VerticalOptions="FillAndExpand"/>

                                            <Grid HorizontalOptions="FillAndExpand">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="3.5*"/>

                                                </Grid.ColumnDefinitions>
                                                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="10">
                                                    <Label Text="||" TextColor="#032d6e" FontSize="27" FontAttributes="Bold"
                                                   HorizontalOptions="Center"/>
                                                    <Label Text="ISEPS" TextColor="#032d6e" FontSize="10" FontAttributes="Bold"
                                                   HorizontalOptions="Center" Margin="0,-10,0,0"/>
                                                </StackLayout>
                                                <BoxView Grid.Column="1" BackgroundColor="Transparent" WidthRequest="1" HorizontalOptions="Start"  VerticalOptions="FillAndExpand"/>
                                                <StackLayout Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" Margin="-60,5,-5,7"
                                                        Padding="30,0,20,10" Spacing="5">

                                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*,*">


                                                        <Label Grid.Row="1" LineBreakMode="NoWrap"  Text="PAYER NAME:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                                        <Label   Grid.Row="1" LineBreakMode="NoWrap"  Grid.Column="1" Text="{Binding payerName}"  FontAttributes="Bold"  TextColor="Red" FontSize="12"/>

                                                        <Label Grid.Row="2" LineBreakMode="NoWrap"  Text="PAYER ID:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                                        <Label   Grid.Row="2" LineBreakMode="NoWrap"  Grid.Column="1" Text="{Binding payerId}"  FontAttributes="Bold" TextColor="Black" FontSize="12"/>

                                                        <Label Grid.Row="5" LineBreakMode="NoWrap"  Text="AMOUNT:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                                        <Label   Grid.Row="5" LineBreakMode="NoWrap"  Grid.Column="1" Text="{Binding amount}" FontAttributes="Bold"  TextColor="Red" FontSize="12"/>

                                                        <Label Grid.Row="4" LineBreakMode="NoWrap"  Text="SERVICE NAME :"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                                        <Label   Grid.Row="4" LineBreakMode="NoWrap"  Grid.Column="1" Text="{Binding serviceName}"  FontAttributes="Bold" TextColor="ForestGreen" FontSize="12"/>

                                                        <Label Grid.Row="3" LineBreakMode="NoWrap"  Text="PAYREF:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                                        <Label   Grid.Row="3" LineBreakMode="NoWrap"  Grid.Column="1" Text="{Binding payRef}" FontAttributes="Bold"  TextColor="Black" FontSize="12"/>

                                                        <Label Grid.Row="6" LineBreakMode="NoWrap"  Text="DATE:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                                        <Label   Grid.Row="6" LineBreakMode="NoWrap"  Grid.Column="1"   FontAttributes="Bold" Text="{Binding dateRecorded, StringFormat='{}{0:MMMM d, yyyy h:mm tt}'}" TextColor="Blue" FontSize="12"/>



                                                    </Grid>


                                                </StackLayout>
                                            </Grid>

                                        </Grid>
                                    </yummy:PancakeView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>



                </StackLayout>

            </yummy:PancakeView>

        </StackLayout>
    </ScrollView>


</ContentPage>