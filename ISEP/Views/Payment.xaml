<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.Payment"     
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#059669" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#64748B" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#CBD5E1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="ReprintButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#D97706" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="FieldLabelStyle" TargetType="Label">
                <Setter Property="Margin" Value="2,0,0,6"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#0F172A"/>
                <Setter Property="CharacterSpacing" Value="1.0"/>
            </Style>

            <Style x:Key="InputFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="#CBD5E1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BackgroundColor" Value="#F8FAFC" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Semi-transparent Dimmed Backdrop -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#90000000" Offset="0.0" />
                <GradientStop Color="#C0000000" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <!-- Loading Indicator Overlay -->
        <StackLayout x:Name="LoadingContainer" 
                     IsVisible="False" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     BackgroundColor="#0A192F"
                     Padding="30,20"
                     Spacing="15">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#059669"
                               Scale="1.5" />
            <Label Text="Processing Payment..."
                   TextColor="White"
                   FontSize="15"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </StackLayout>

        <!-- Bottom Sheet Container -->
        <Frame x:Name="SheetFrame"
               VerticalOptions="End" 
               HorizontalOptions="FillAndExpand"
               BackgroundColor="White"
               CornerRadius="20"
               HasShadow="True"
               Padding="0"
               Margin="0"
               TranslationY="350">

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetTapped" />
            </Frame.GestureRecognizers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sheet Drag Handle Bar -->
                <StackLayout x:Name="DragHandleArea"
                             Grid.Row="0" 
                             Padding="0,12,0,10" 
                             BackgroundColor="Transparent"
                             HeightRequest="40">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSheetTapped" />
                    </StackLayout.GestureRecognizers>
                    <BoxView x:Name="DragHandle"
                             HeightRequest="5"
                             WidthRequest="45"
                             BackgroundColor="#CBD5E1"
                             HorizontalOptions="Center"
                             VerticalOptions="Start"
                             CornerRadius="2.5" />
                </StackLayout>

                <!-- Main Form Body -->
                <ScrollView Grid.Row="1" 
                            Padding="25,0,25,30" 
                            VerticalScrollBarVisibility="Never">
                    <StackLayout Spacing="16" Orientation="Vertical">

                        <!-- Header -->
                        <StackLayout Spacing="6" HorizontalOptions="Center" Margin="0,0,0,5">
                            <Image Source="Borno" 
                                   Aspect="AspectFit"
                                   HeightRequest="75"
                                   HorizontalOptions="Center"/>

                            <Label Text="BORNO STATE REVENUE SERVICE" 
                                   FontSize="16" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"
                                   TextColor="#0A192F" />

                            <Label Text="SECURE COLLECTION PAYMENT" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"
                                   TextColor="#059669" />
                        </StackLayout>

                        <!-- Invoice / RRR Input -->
                        <StackLayout Spacing="6">
                            <Label Text="INVOICE / RRR NUMBER" Style="{StaticResource FieldLabelStyle}"/>
                            <Frame x:Name="TokenInputFrame" Style="{StaticResource InputFrameStyle}">
                                <Entry x:Name="inputtoken"
                                       Placeholder="Enter RRR / Invoice Ref" 
                                       HorizontalOptions="FillAndExpand"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       TextChanged="OnTokenTextChanged"
                                       Completed="OnTokenCompleted"
                                       MaxLength="30"
                                       ClearButtonVisibility="WhileEditing"
                                       PlaceholderColor="#94A3B8" />
                            </Frame>
                        </StackLayout>

                        <!-- Payment Method Picker -->
                        <StackLayout Spacing="6">
                            <Label Text="PAYMENT METHOD" Style="{StaticResource FieldLabelStyle}"/>
                            <Frame Style="{StaticResource InputFrameStyle}">
                                <Picker Title="Select Payment Method"
                                        FontSize="14"    
                                        x:Name="paymentmethod"
                                        BackgroundColor="Transparent"
                                        TitleColor="#94A3B8"
                                        TextColor="#0F172A"
                                        HorizontalOptions="FillAndExpand"
                                        SelectedIndexChanged="OnPaymentMethodChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Cash</x:String>
                                            <x:String>POS Transfer</x:String>
                                            <x:String>Bank Direct</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </Frame>
                        </StackLayout>

                        <!-- Error / Success Notification Frame -->
                        <StackLayout x:Name="MessageContainer" IsVisible="False">
                            <Frame x:Name="MessageFrame"
                                   CornerRadius="10"
                                   HasShadow="False"
                                   Padding="12"
                                   Margin="0,5">
                                <StackLayout Orientation="Horizontal" Spacing="10">
                                    <Label x:Name="MessageIcon" FontSize="16" VerticalOptions="Center" />
                                    <Label x:Name="MessageLabel" FontSize="12" VerticalOptions="Center" HorizontalOptions="FillAndExpand" LineBreakMode="WordWrap" />
                                </StackLayout>
                            </Frame>
                        </StackLayout>

                        <!-- Action Buttons -->
                        <StackLayout Spacing="8" Margin="0,10,0,0">
                            <!-- Process Payment -->
                            <Button x:Name="VerifyButton"
                                    Text="PROCESS PAYMENT"
                                    Clicked="OnVerifyTokenClicked"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="False"/>

                            <!-- Reprint Button (Hidden by default; appears if receipt print fails) -->
                            <Button x:Name="ReprintButton"
                                    Text="🖨️ REPRINT RECEIPT"
                                    Style="{StaticResource ReprintButtonStyle}"
                                    IsVisible="False"
                                    Clicked="OnReprintReceiptClicked"/>

                            <!-- Cancel Sheet -->
                            <Button x:Name="CancelButton"
                                    Text="CANCEL" 
                                    Clicked="OnCancelClicked"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackLayout>

                        <!-- Security Footer -->
                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="6" Margin="0,10,0,0">
                            <Label Text="🔒" FontSize="11" />
                            <Label Text="Protected by BOIRS Secure Payment Protocol"
                                   FontSize="11"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center" />
                        </StackLayout>

                    </StackLayout>
                </ScrollView>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>