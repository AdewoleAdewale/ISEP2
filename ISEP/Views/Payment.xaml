<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ISEP.Views.Payment"     
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#1E3A8A" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#64748B" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="#CBD5E1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="ReprintButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#D97706" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="52" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Margin" Value="0,5" />
            </Style>

            <Style x:Key="FieldHeaderLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#64748B"/>
                <Setter Property="CharacterSpacing" Value="0.8"/>
            </Style>

            <Style x:Key="DisplayValueLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#0F172A"/>
            </Style>

            <Style x:Key="DisplayCardFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="#E2E8F0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BackgroundColor" Value="#F8FAFC" />
            </Style>

            <Style x:Key="InputFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BorderColor" Value="#CBD5E1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#90000000" Offset="0.0" />
                <GradientStop Color="#C0000000" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" />
        </Grid.GestureRecognizers>

        <StackLayout x:Name="LoadingContainer" 
                     IsVisible="False" 
                     VerticalOptions="Center" 
                     HorizontalOptions="Center"
                     BackgroundColor="#0A192F"
                     Padding="30,20"
                     Spacing="15">
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="#1E3A8A"
                               Scale="1.5" />
            <Label Text="Processing Payment..."
                   TextColor="White"
                   FontSize="15"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
        </StackLayout>

        <Frame x:Name="SheetFrame"
               VerticalOptions="End" 
               HorizontalOptions="FillAndExpand"
               BackgroundColor="White"
               CornerRadius="20"
               HasShadow="True"
               Padding="0"
               Margin="0"
               TranslationY="400">

            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSheetTapped" />
            </Frame.GestureRecognizers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackLayout x:Name="DragHandleArea"
                             Grid.Row="0" 
                             Padding="0,12,0,10" 
                             BackgroundColor="Transparent"
                             HeightRequest="40">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSheetTapped" />
                    </StackLayout.GestureRecognizers>
                    <BoxView x:Name="DragHandle"
                             HeightRequest="5"
                             WidthRequest="45"
                             BackgroundColor="#CBD5E1"
                             HorizontalOptions="Center"
                             VerticalOptions="Start"
                             CornerRadius="2.5" />
                </StackLayout>

                <ScrollView Grid.Row="1" 
                            Padding="25,0,25,25" 
                            VerticalScrollBarVisibility="Never">
                    <StackLayout Spacing="12" Orientation="Vertical">

                        <StackLayout Spacing="4" HorizontalOptions="Center" Margin="0,0,0,5">
                            <Image Source="Borno" 
                                   Aspect="AspectFit"
                                   HeightRequest="60"
                                   HorizontalOptions="Center"/>

                            <Label Text="BORNO STATE REVENUE SERVICE" 
                                   FontSize="14" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"
                                   TextColor="#0A192F" />

                            <Label Text="PROCESS PAYMENT" 
                                   FontSize="12" 
                                   FontAttributes="Bold" 
                                   HorizontalTextAlignment="Center"
                                   TextColor="#1E3A8A" />
                        </StackLayout>

                        <Frame Style="{StaticResource DisplayCardFrameStyle}">
                            <StackLayout Spacing="2">
                                <Label Text="RRR / REFERENCE NUMBER" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                <Label x:Name="lblRefrencenum" Text="---" Style="{StaticResource DisplayValueLabelStyle}" TextColor="#1E3A8A"/>
                            </StackLayout>
                        </Frame>

                        <Frame Style="{StaticResource DisplayCardFrameStyle}">
                            <StackLayout Spacing="2">
                                <Label Text="TAX NAME" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                <Label x:Name="lblTaxName" Text="---" Style="{StaticResource DisplayValueLabelStyle}"/>
                            </StackLayout>
                        </Frame>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Frame Grid.Column="0" Style="{StaticResource DisplayCardFrameStyle}">
                                <StackLayout Spacing="2">
                                    <Label Text="ACTUAL AMOUNT" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                    <Label x:Name="lblActualAmount" Text="₦0.00" Style="{StaticResource DisplayValueLabelStyle}"/>
                                </StackLayout>
                            </Frame>

                            <Frame Grid.Column="1" Style="{StaticResource DisplayCardFrameStyle}">
                                <StackLayout Spacing="2">
                                    <Label Text="BALANCE UNPAID" Style="{StaticResource FieldHeaderLabelStyle}"/>
                                    <Label x:Name="lblBalanceToPay" Text="₦0.00" Style="{StaticResource DisplayValueLabelStyle}" TextColor="#D97706"/>
                                </StackLayout>
                            </Frame>
                        </Grid>

                        <StackLayout Spacing="4">
                            <Label Text="AMOUNT TO PAY (₦) *" Style="{StaticResource FieldHeaderLabelStyle}" TextColor="#0F172A"/>
                            <Frame x:Name="AmountFrame" Style="{StaticResource InputFrameStyle}">
                                <Entry x:Name="amount"
                                       Placeholder="Enter Amount" 
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A"
                                       ClearButtonVisibility="WhileEditing"
                                       PlaceholderColor="#94A3B8" />
                            </Frame>
                        </StackLayout>

                        <StackLayout Spacing="4">
                            <Label Text="AGENT PIN *" Style="{StaticResource FieldHeaderLabelStyle}" TextColor="#0F172A"/>
                            <Frame x:Name="PinFrame" Style="{StaticResource InputFrameStyle}">
                                <Entry x:Name="PIN"
                                       Placeholder="Enter 4-Digit PIN" 
                                       IsPassword="True"
                                       MaxLength="4"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       FontSize="14"
                                       TextColor="#0F172A"
                                       TextChanged="OnPinTextChanged"
                                       Completed="OnPinCompleted"
                                       PlaceholderColor="#94A3B8" />
                            </Frame>
                        </StackLayout>

                        <StackLayout x:Name="MessageContainer" IsVisible="False">
                            <Frame x:Name="MessageFrame"
                                   CornerRadius="10"
                                   HasShadow="False"
                                   Padding="12"
                                   Margin="0,5">
                                <StackLayout Spacing="6">
                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                        <Label x:Name="MessageIcon" FontSize="16" VerticalOptions="Center" />
                                        <Label x:Name="MessageTitle" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </StackLayout>
                                    <Label x:Name="MessageLabel" FontSize="12" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                </StackLayout>
                            </Frame>
                        </StackLayout>

                        <StackLayout Spacing="8" Margin="0,10,0,0">
                            <Button x:Name="VerifyButton"
                                    Text="PROCESS PAYMENT"
                                    Clicked="OnVerifyTokenClicked"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="False"/>

                            <Button x:Name="ReprintButton"
                                    Text="🖨️ REPRINT RECEIPT"
                                    Style="{StaticResource ReprintButtonStyle}"
                                    IsVisible="False"
                                    Clicked="OnReprintReceiptClicked"/>

                            <Button x:Name="CancelButton"
                                    Text="CANCEL" 
                                    Clicked="OnCancelClicked"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackLayout>

                        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="6" Margin="0,5,0,0">
                            <Label Text="🔒" FontSize="11" />
                            <Label Text="Protected by BOIRS Secure Payment Protocol"
                                   FontSize="11"
                                   TextColor="#64748B"
                                   HorizontalOptions="Center" />
                        </StackLayout>

                    </StackLayout>
                </ScrollView>
            </Grid>
        </Frame>
    </Grid>
</ContentPage>