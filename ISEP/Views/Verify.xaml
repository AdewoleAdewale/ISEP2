<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:renderers1="clr-namespace:ISEP.Randerers" xmlns:yummy="clr-namespace:Xamarin.Forms.PancakeView;assembly=Xamarin.Forms.PancakeView"
             x:Class="ISEP.Views.Verify"
             NavigationPage.HasNavigationBar="True"
             BackgroundColor="White"
            Padding="0,40,0,0">

    <ScrollView HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" BackgroundColor="Transparent">
        <StackLayout BackgroundColor="Transparent" >
            <StackLayout  Margin="0,0,0,0"  Orientation="Horizontal">
                <StackLayout Margin="20,10,20,0" Spacing="20">


                    <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Padding="10"
                    Text="ASSESMENT VERIFICATION"
                    TextColor="#032d6e"
                    VerticalOptions="CenterAndExpand" />
                </StackLayout>

                <Image
                    HorizontalOptions="EndAndExpand"
                    Source="verify.png"
                   Margin="5,-5,10,-5"
                    WidthRequest="120" />

            </StackLayout>
            <yummy:PancakeView
            Margin="0,10,0,0"
            Padding="30,50,30,30"
            BackgroundColor="White"
            CornerRadius="40,40,0,0"
            VerticalOptions="FillAndExpand">
                <StackLayout Spacing="10">


                    <StackLayout Spacing="10">
                        <Label
                        Margin="20,0,0,0"
                        FontSize="15"
                        FontAttributes="Bold"
                        Text="RRR NUMBER"
                        TextColor="#032d6e" />
                        <yummy:PancakeView
                        Padding="10,0,0,0"
                        BackgroundColor="WhiteSmoke"
                        BorderThickness="1"
                        CornerRadius="5"
                        Elevation="3"
                        HeightRequest="50">
                            <renderers1:BorderlessEntry
                            FontSize="12"
                             ClearButtonVisibility="WhileEditing"
                            IsPassword="False"    
                                 BackgroundColor="WhiteSmoke"
                                Keyboard="Numeric"
                                Focused="refno_Focused"
                            Placeholder="Kindly Input RRR number for Verification"
                            TextColor="#484848" 
                                x:Name="refno"/>
                        </yummy:PancakeView>
                    </StackLayout>

                    <yummy:PancakeView
                        
                        x:Name="rrrbtn"
              BackgroundColor="Transparent" BackgroundGradientStartColor="#032d6e"
                    BackgroundGradientAngle="45" BackgroundGradientEndColor="#032d6e"  BorderColor="Transparent"
                     Elevation="5"
                BorderThickness="1"
       
                HasShadow="True"
                 Margin="0, 30, 0, 0"
                HeightRequest="55"
                CornerRadius="10"
                HorizontalOptions="FillAndExpand"
                WidthRequest="150">
                        <Label
                    FontAttributes="Bold"
                    FontSize="17"
                    HorizontalOptions="CenterAndExpand"
                    Text="VERIFY RRR NUMBER "
                    TextColor="White"
                    VerticalOptions="CenterAndExpand" >

                        </Label>
                        <yummy:PancakeView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_2" ></TapGestureRecognizer>
                        </yummy:PancakeView.GestureRecognizers>



                    </yummy:PancakeView>



                </StackLayout>
            </yummy:PancakeView>




            <StackLayout Spacing="10" BackgroundColor="White" Margin="-5,0,0,100" x:Name="assestmentstack">
                <Grid Margin="0,0,0,0" BackgroundColor="White">
                    <StackLayout Margin="20,0,20,0" BackgroundColor="White" Spacing="20">

                        <Label Text=" ASSESMENT DETAILS " TextColor="#032d6e" FontSize="18" FontAttributes="Bold" BackgroundColor="White" HorizontalOptions="CenterAndExpand"/>
                    </StackLayout>

                </Grid>


                <yummy:PancakeView  Margin="0,10,0,0" Padding="10,0,10,10" BackgroundColor="White" CornerRadius="10,10,0,0" VerticalOptions="FillAndExpand" x:Name="responselist" >
                    <StackLayout>

                        <yummy:PancakeView  BackgroundColor="White" VerticalOptions="StartAndExpand"  
                                    HorizontalOptions="FillAndExpand">
                            <Grid VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <BoxView BackgroundColor="#032d6e" WidthRequest="5" HorizontalOptions="Start" VerticalOptions="FillAndExpand"/>

                                <Grid HorizontalOptions="FillAndExpand">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="3.5*"/>

                                    </Grid.ColumnDefinitions>
                                    <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="10">
                                        <Label Text="||" TextColor="#032d6e" FontSize="27" FontAttributes="Bold"
                                                   HorizontalOptions="Center"/>
                                        <Label Text="ISEP" TextColor="#032d6e" FontSize="10" FontAttributes="Bold"
                                                   HorizontalOptions="Center" Margin="0,-10,0,0"/>
                                    </StackLayout>
                                    <BoxView Grid.Column="1" BackgroundColor="Transparent" WidthRequest="1" HorizontalOptions="Start"  VerticalOptions="FillAndExpand"/>
                                    <StackLayout Grid.Column="2" HorizontalOptions="Start" VerticalOptions="Center" Margin="5">

                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*,*">

                                            <Label Grid.Row="0" LineBreakMode="NoWrap"  Text="----Space----"   FontSize="20" FontAttributes="Bold" TextColor="Transparent"></Label>


                                            <Label Grid.Row="1" LineBreakMode="NoWrap"  Text="PAYER NAME:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                            <Label   Grid.Row="1" LineBreakMode="NoWrap"  Grid.Column="1" x:Name="payername" TextColor="Black" FontSize="12" FontAttributes="Bold"/>

                                            <Label Grid.Row="2" LineBreakMode="NoWrap"  Text="PHONE NUMBER:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                            <Label   Grid.Row="2" LineBreakMode="NoWrap"  Grid.Column="1" x:Name="phone" TextColor="Black" FontSize="12" FontAttributes="Bold"/>

                                            <Label Grid.Row="3" LineBreakMode="NoWrap"  Text="ACTUAL AMOUNT:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                            <Label   Grid.Row="3" LineBreakMode="NoWrap"  Grid.Column="1" x:Name="amount" TextColor="ForestGreen" FontSize="12" FontAttributes="Bold"/>

                                            <Label Grid.Row="5" LineBreakMode="NoWrap"  Text="PAYMENT REF:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                            <Label   Grid.Row="5" LineBreakMode="NoWrap"  Grid.Column="1" x:Name="paymentRef" TextColor="Black" FontSize="12" FontAttributes="Bold"/>

                                            <Label Grid.Row="6" LineBreakMode="NoWrap"  Text="PAYER ID:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                            <Label   Grid.Row="6" LineBreakMode="NoWrap"  Grid.Column="1" x:Name="payerId" TextColor="Black" FontSize="12" FontAttributes="Bold"/>

                                            <Label Grid.Row="7" LineBreakMode="NoWrap"  Text="CATEGORY:"   FontSize="12" FontAttributes="Bold" TextColor="#032d6e"></Label>

                                            <Label   Grid.Row="7" LineBreakMode="NoWrap"  Grid.Column="1" x:Name="demandNoticeCategory" TextColor="ForestGreen" FontSize="12" FontAttributes="Bold"/>

                                            <Label   Grid.Row="8" LineBreakMode="NoWrap"   Text="DATE:" TextColor="#032d6e" FontSize="12" FontAttributes="Bold"/>

                                            <Label   Grid.Row="8" LineBreakMode="NoWrap"    Grid.Column="1" x:Name="date" TextColor="Red" FontSize="12" FontAttributes="Bold"/>

                                            <Label   Grid.Row="9" LineBreakMode="NoWrap"   Text="TAX NAME:" TextColor="#032d6e" FontSize="12" FontAttributes="Bold"/>

                                            <Label   Grid.Row="9" LineBreakMode="NoWrap"    Grid.Column="1" x:Name="taxName" TextColor="Black" FontSize="12" FontAttributes="Bold"/>

                                            <Label   Grid.Row="4" LineBreakMode="NoWrap"   Text="BALANCE TO PAY:" TextColor="#032d6e" FontSize="12" FontAttributes="Bold"/>

                                            <Label   Grid.Row="4" LineBreakMode="NoWrap"    Grid.Column="1" x:Name="balance" TextColor="ForestGreen" FontSize="12" FontAttributes="Bold"/>



                                        </Grid>
                                        <Button Padding="10" Margin="40" BackgroundColor="#032d6e"  x:Name="paymentbtn" Text="PROCESS PAYMENT" CornerRadius="10" Clicked="paymentbtn_Clicked" TextColor="White" HorizontalOptions="FillAndExpand" VerticalOptions="CenterAndExpand"></Button>

                                        <Label  LineBreakMode="NoWrap"  Text="----Space----"   FontSize="10" FontAttributes="Bold" TextColor="Transparent"></Label>


                                    </StackLayout>
                                </Grid>

                            </Grid>


                        </yummy:PancakeView>




                    </StackLayout>

                </yummy:PancakeView>
            </StackLayout>


        </StackLayout>
    </ScrollView>
</ContentPage>